  <property name="styleSheet">
   <string notr="true">QMainWindow { background: #f3f6fa; }
QFrame#headerFrame { background: #ffffff; border-bottom: 1px solid #dce3eb; }
QFrame#cardFrame, QFrame#leftCard, QFrame#statementCard, QFrame#judgeCard, QFrame#resultCard { background: #ffffff; border: 1px solid #d9e1ea; border-radius: 8px; }
QLabel#brandTitle { color: #172235; font-size: 18px; font-weight: 700; }
QLabel#sectionTitle { color: #172235; font-size: 15px; font-weight: 700; }
QLabel#outputTitle { color: #374151; font-weight: 600; }
QPushButton { background: #ffffff; border: 1px solid #d5dde7; border-radius: 6px; padding: 6px 12px; color: #27364a; }
QPushButton:hover { background: #f1f6ff; border-color: #8cb2ef; }
QPushButton:pressed { background: #e5efff; }
QPushButton#judgeButton { background: #2468d8; border-color: #2468d8; color: #ffffff; font-weight: 700; }
QPushButton#judgeButton:enabled:hover { background: #1c58ba; }
QPushButton#judgeButton:disabled {
    background: #e5e7eb;
    border-color: #d1d5db;
    color: #6b7280;
}
QLineEdit, QTextEdit, QTableWidget {
    background: #ffffff;
    color: #172235;
    selection-background-color: #2468d8;
    selection-color: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 5px;
}
QTableWidget { gridline-color: #e6ebf1; }
QHeaderView::section { background: #f5f7fa; color: #374151; border: 0px; border-bottom: 1px solid #d9e1ea; padding: 7px; font-weight: 600; }
QLabel#resultLabel { background: #eef3fb; border: 1px solid #d7e1f2; border-radius: 12px; color: #37649d; padding: 4px 12px; }
QLabel#statusLabel { color: #718096; }
QTextEdit#actualOutputText, QTextEdit#expectedOutputText, QTextEdit#errorOutputText { background: #fbfcfe; }</string>
