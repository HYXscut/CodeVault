  <property name="styleSheet">
   <string notr="true">QDialog {
    background: white;
    border: 1px solid #D9DEE8;
    border-radius: 14px;
}
QFrame#leftPanel {
    border-image: url(:/login_background.svg) 0 0 0 0 stretch stretch;
    border-top-left-radius: 14px;
    border-bottom-left-radius: 14px;
}
QLabel#acBadge, QLabel#cppBadge {
    color: white;
    background: rgba(255, 255, 255, 35);
    border: 1px solid rgba(255, 255, 255, 90);
    border-radius: 7px;
    padding: 5px 8px;
    font-size: 12px;
}
QLabel#logoLabel {
    color: transparent;
    background: transparent;
    border: none;
    border-radius: 32px;
    min-width: 58px;
    max-width: 58px;
    min-height: 58px;
    max-height: 58px;
    font-size: 22px;
    font-weight: bold;
}
QLabel#brandLabel {
    color: white;
    font-size: 25px;
    font-weight: bold;
    margin-top: 8px;
}
QLabel#brandSubtitleLabel {
    color: #D8E2FF;
    font-size: 13px;
}
QLabel#versionLabel {
    color: #D8E2FF;
    font-size: 11px;
}
QFrame#rightPanel {
    background: white;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
}
QLabel#titleLabel {
    color: #20242B;
    font-size: 22px;
    font-weight: bold;
}
QLabel#descriptionLabel {
    color: #8A919D;
    font-size: 12px;
}
QLabel#usernameLabel, QLabel#passwordLabel {
    color: #303641;
    font-size: 12px;
}
QLineEdit {
    min-height: 34px;
    border: 1px solid #D4DAE4;
    border-radius: 6px;
    padding: 0 10px;
    color: #252A33;
    background: #FFFFFF;
}
QLineEdit:focus {
    border: 2px solid #4D82E8;
    padding: 0 9px;
}
QPushButton#closeButton {
    color: #7E8794;
    border: none;
    background: transparent;
    font-size: 22px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
}
QPushButton#closeButton:hover {
    color: #252A33;
    background: #F0F2F5;
    border-radius: 12px;
}
QPushButton#loginButton, QPushButton#registerButton, QPushButton#cancelButton {
    min-height: 34px;
    min-width: 70px;
    border-radius: 6px;
    padding: 0 12px;
    font-size: 13px;
}
QPushButton#loginButton {
    color: white;
    background: #3269D7;
    border: 1px solid #3269D7;
}
QPushButton#loginButton:hover {
    background: #285BC3;
}
QPushButton#registerButton, QPushButton#cancelButton {
    color: #303641;
    background: white;
    border: 1px solid #D4DAE4;
}
QPushButton#registerButton:hover, QPushButton#cancelButton:hover {
    background: #F5F7FA;
}
QLabel#messageLabel {
    color: #D64545;
    font-size: 12px;
    min-height: 20px;
}</string>
